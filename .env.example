# Copy this file to .env (same folder as docker-compose.yml) to rebrand
# both services at once when running via Docker. docker compose reads
# this file automatically — no need to edit docker-compose.yml.

# Shown in the page header, browser tab, and API title.
APP_NAME=Price Oracle

# Only needed if the frontend is served from a different host/port than
# the backend (e.g. deployed behind a custom domain).
NEXT_PUBLIC_API_BASE=http://localhost:8000
