# Copy this file to .env and fill in your own values.

# Optional. Shown as your product name in the API title.
APP_NAME=Price Oracle

# Optional. Comma-separated list of frontend origins allowed to call this
# API (e.g. https://app.example.com,https://www.example.com). Defaults
# to "*" (any origin) which is fine for local dev but should be
# restricted before going live with real users.
ALLOWED_ORIGINS=*

# Optional. Enables POST /data/refresh-gold-price (gold history + spot price
# from goldapi.io). Get a free key at https://www.goldapi.io/dashboard —
# the free tier is capped around 100 requests/month, so this stays optional.
# Without it, that one endpoint returns an error but everything else works.
GOLDAPI_KEY=
